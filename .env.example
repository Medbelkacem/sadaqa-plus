# =============================================================================
# Sadaqa+ — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# =============================================================================

# --- Core -------------------------------------------------------------------
# Public origin of the deployment. Used for links in emails, OG tags, push.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Server-side secret used to derive session/token hashing keys (HMAC pepper).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Database (required) ----------------------------------------------------
# PostgreSQL 14+. Local docker-compose default shown below.
DATABASE_URL=postgresql://sadaqa:sadaqa@localhost:5432/sadaqa_app?schema=public
# Direct (unpooled) connection used by `prisma migrate`. A transaction pooler
# cannot hold the session-level locks DDL needs. With a managed provider this is
# the "unpooled"/"non-pooling" URL; locally it is the same as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://sadaqa:sadaqa@localhost:5432/sadaqa_app?schema=public

# --- Redis (optional; rate limiting falls back to in-memory when unset) ------
# In-memory fallback is per-instance only and NOT safe for multi-instance
# production deployments. Set this before scaling beyond one instance.
REDIS_URL=redis://localhost:6379

# --- File storage -----------------------------------------------------------
# STORAGE_DRIVER = local | s3 | blob
#   local — writes to STORAGE_LOCAL_DIR. Fine for a single long-lived server;
#           NEVER on serverless, where the filesystem is ephemeral and uploads
#           would silently disappear between invocations.
#   s3    — any S3-compatible bucket; issues short-lived signed URLs.
#   blob  — Vercel Blob with private access. Needs BLOB_READ_WRITE_TOKEN,
#           set automatically by `vercel blob create-store <name> --access private`.
# Every driver serves private files through the authorized /api/files/[id]
# route, which re-checks permissions on each read.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Email ------------------------------------------------------------------
# EMAIL_DRIVER = log | smtp
# `log` prints rendered emails to the server log (development only). No email
# is silently dropped: the outbox records every attempt either way.
EMAIL_DRIVER=log
EMAIL_FROM="Sadaqa+ <no-reply@localhost>"
EMAIL_SERVER=
# e.g. smtp://user:password@smtp.example.com:587

# --- Web Push (optional) ----------------------------------------------------
# Generate a VAPID key pair with: npm run push:keys
# Push is disabled and reported as "not configured" when these are absent.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:contact@example.com
NEXT_PUBLIC_PUSH_PUBLIC_KEY=

# --- Map --------------------------------------------------------------------
# Defaults to OpenStreetMap raster tiles, which need no key. Override to use a
# commercial provider. Respect the tile provider's usage policy in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Payments (optional) ----------------------------------------------------
# PAYMENT_PROVIDER = none | satim | chargily
# With `none`, online payment is reported as not configured in the UI and no
# donation can ever reach CONFIRMED through the web flow.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- AI assistance (optional) -----------------------------------------------
# AI_PROVIDER = none | anthropic
# Used only to assist human moderators. Never auto-decides on a request.
AI_PROVIDER=none
AI_PROVIDER_KEY=
AI_MODEL=claude-sonnet-5

# --- First administrator ----------------------------------------------------
# Consumed once by `npm run bootstrap:admin`, then should be removed.
# The command refuses to run if an active SUPER_ADMIN already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (Vercel Cron / any scheduler).
CRON_SECRET=
